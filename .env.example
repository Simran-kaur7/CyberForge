# CyberForge Environment Variables
# Copy to .env and fill in your values. Never commit .env with real keys.

# Model provider (used by TrueForge agent)
MODEL_PROVIDER=anthropic
MODEL_API_KEY=sk-ant-xxx

# Daytona sandbox provider (used by TrueForge for sandbox execution)
DAYTONA_API_KEY=your-daytona-api-key

# TrueForge server (default: http://localhost:8790)
TRUEFORGE_URL=http://localhost:8790
